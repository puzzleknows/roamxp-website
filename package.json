{
  "name": "roamxp-website",
  "private": true,
  "description": "RoamXP marketing site — Playwright QA for /get/ and /go/ smart links",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all": "PW_WEBKIT=1 playwright test --project=chromium --project=webkit",
    "test:report": "playwright show-report",
    "test:smoke:prod": "PLAYWRIGHT_BASE_URL=https://roamxp.puzdev.com PW_CHANNEL=chrome playwright test --project=production-smoke",
    "test:install": "playwright install chromium webkit"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1"
  }
}
